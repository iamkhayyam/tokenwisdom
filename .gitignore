__pycache__/
*.pyc
.DS_Store
mcp-server/node_modules/
api/node_modules/
worker/node_modules/
ghost-webhook/node_modules/
.env
*.env
.dev.vars

# Zernio distribution audit log (grows). The state file, data/.zernio_state.json,
# is deliberately NOT ignored: it must be committed so CI builds see which posts
# were already distributed (see DISTRIBUTION.md §2). Ignoring it makes every
# fresh checkout re-seed and silently never distribute a new post.
data/zernio_outbox.jsonl

# Algolia indexer sidecar state (local-only; tracks objectIDs for deletes)
data/.algolia_state.json

# Scratch screenshots
titles/

# Transient holding dir for docs/social/ during a rebuild (see generate_site.py).
# Should never survive a run; ignored so a crashed build can't commit it.
.social_stash/

# Rendered social cards — PNG masters (2.8 GB) and their JPEG derivatives
# (385 MB, see r2_sync.make_jpegs). Both live in Cloudflare R2, not git;
# data/social_cards.json is the manifest that maps them to URLs. See r2_sync.py.
docs/social/posts/*.png
docs/social/posts/*.jpg

# Wrangler local cache/state (miniflare sqlite, CF metadata) — machine-local
.wrangler/
